# ==============================================================================
# LB Physiotherapy — Apache .htaccess Configuration
# Clean URLs (Extensionless URLs), Canonical Redirection & Security Headers
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect /index.html and /index to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(?:\.html)?(?:[?#\ ]|$) [NC]
  RewriteRule ^index(?:\.html)?$ / [R=301,L]

  # 2. 301 Redirect any request with .html to clean URL (e.g. /services.html -> /services)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html(?:[?#\ ]|$) [NC]
  RewriteRule ^([^.]+)\.html$ /$1 [R=301,L,NE]

  # 3. Strip trailing slashes from non-directory paths (e.g. /services/ -> /services)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/+$
  RewriteRule ^ %1 [R=301,L]

  # 4. Map /recovery-stories to portfolio-details.html
  RewriteRule ^recovery-stories/?$ portfolio-details.html [NC,L]

  # 5. Map /faq (case-insensitive) to FAQ.html
  RewriteRule ^faq/?$ FAQ.html [NC,L]

  # 6. Internally rewrite extensionless requests to the corresponding .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Custom Error Document
ErrorDocument 404 /404.html

# Security and cache headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=()"
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</IfModule>
