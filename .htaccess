# ==============================================================================
# LB Physiotherapy — Apache .htaccess (domains.co.za / cPanel shared hosting)
# Clean URLs (/contact instead of /contact.html), canonical redirects, caching
# Upload this file to public_html together with the .html files.
# ==============================================================================

DirectoryIndex index.html
Options -Indexes

# Fallback: if mod_rewrite is ever unavailable, let Apache find contact.html for /contact
<IfModule !mod_rewrite.c>
  Options +MultiViews
</IfModule>

<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and www (canonical: https://www.lbphysiotherapy.co.za)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L,NE]

  # 2. /index and /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index(?:\.html)?[\s?] [NC]
  RewriteRule ^index(?:\.html)?$ / [R=301,L]

  # 3. /FAQ and /FAQ.html -> /faq (the file is FAQ.html, the URL is lowercase)
  RewriteCond %{THE_REQUEST} \s/FAQ(?:\.html)?[\s?]
  RewriteRule ^FAQ(?:\.html)?$ /faq [R=301,L]

  # 4. Any /page.html typed by a visitor -> /page
  RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 5. Strip trailing slashes from non-directories (/services/ -> /services)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 6. Special clean URLs
  RewriteRule ^faq$ FAQ.html [NC,L]
  RewriteRule ^recovery-stories$ portfolio-details.html [NC,L]

  # 7. /page -> page.html when that file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Branded 404 page
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Caching: pages always fresh, images/fonts/CSS/JS cached (CSS/JS use ?v= to bust)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Never serve dot-files or project config if they get uploaded by accident
<FilesMatch "^(\.env.*|\.git.*|package(-lock)?\.json|server\.js|vercel\.json|_redirects|metadata\.json)$">
  Require all denied
</FilesMatch>
